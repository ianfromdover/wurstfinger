          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ισχύει όταν σέρνετε το πλήκτρο διαστήματος ή διαγραφής για να μετακινήσετε τον δρομέα ή να διαγράψετε κείμενο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
